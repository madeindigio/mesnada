{
  "mcp": {
    "local": {
      "type": "local",
      "command": [
        "node",
        "server.js"
      ],
      "enabled": true,
      "timeout": 5000
    },
    "remote": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://example.com/mcp"
      ],
      "enabled": true,
      "timeout": 5000
    }
  }
}